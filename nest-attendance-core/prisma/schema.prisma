generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider     = "mysql"
  relationMode = "foreignKeys"
}

model Attendance {
  id         String   @id @default(uuid())
  userId     String
  email      String
  employeeId String
  imageKey   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}
